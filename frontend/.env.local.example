# URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudflare Turnstile site key (public, safe to expose in the browser).
# Leave blank to disable the CAPTCHA widget on signup.
# IMPORTANT: if you set TURNSTILE_SECRET_KEY on the backend, you MUST
# also set this, or every signup breaks -- the backend will require a
# token but the frontend will never show a widget to produce one. The
# reverse (this set, backend not) is harmless -- just an unused widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# OAuth client IDs (NOT secrets -- safe to expose in the browser, the
# actual secrets stay backend-only). Leave blank to hide the
# corresponding "Continue with ..." button on login/signup.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
