# --- Core ---
# Local dev default is SQLite. For production, point this at a Postgres
# instance (e.g. Supabase or Railway) and nothing else in the code changes:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/agent.db

# Long random string — used to sign login sessions. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string

# How long a login session lasts, in minutes
JWT_EXPIRE_MINUTES=43200

# Used to build password-reset links emailed to users -- must match
# wherever the frontend is actually deployed.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Anthropic (job matching + resume tailoring) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Email (used to notify users of new matches) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Riseply
# Where "Contact support" messages from the app get sent. Leave blank to
# default to SMTP_USER (i.e. support messages land in the same inbox
# that sends notifications).
SUPPORT_EMAIL=

# --- Stripe (subscriptions + tips) ---
STRIPE_SECRET_KEY=
# Webhook signing secret from your Stripe webhook endpoint config.
# Required in production -- without it, anyone could fake a "payment
# succeeded" event. Fine to leave blank only for local testing.
STRIPE_WEBHOOK_SECRET=
# The recurring monthly Price ID for the Pro plan, created in your Stripe
# dashboard (Products -> add a recurring price). Looks like "price_1AbC...".
STRIPE_PRICE_ID_PRO=
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard/billing?upgrade=success
STRIPE_CANCEL_URL=http://localhost:3000/dashboard/billing?upgrade=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/dashboard/billing
# Estimate only, used for the admin MRR display -- update manually if you
# change the actual price in Stripe.
PRO_PRICE_USD_DISPLAY=9.99

# One-time admin bootstrap secret. POST /admin/bootstrap with this value
# promotes an account to admin -- there's no other way to create the
# first admin. Generate with:
# python -c "import secrets; print(secrets.token_hex(24))"
# Treat like any other credential; fine to unset after you've used it once.
ADMIN_BOOTSTRAP_SECRET=

# --- Scheduled matching ---
# Shared secret an external scheduler sends as X-Cron-Secret to trigger
# POST /internal/scheduled-run. Blank disables the endpoint (503).
CRON_SECRET=

# --- Signup abuse protection ---
# Cloudflare Turnstile (CAPTCHA). Leave blank to disable -- signup works
# normally without it, just with no bot protection. Get keys from the
# Cloudflare dashboard: Turnstile -> Add site.
TURNSTILE_SECRET_KEY=

# --- OAuth sign-in (Google, Microsoft) ---
# Leave blank to disable the corresponding "Continue with ..." button.
# Client secrets are backend-only, never sent to the frontend.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Frontend base URL -- used to build the redirect_uri sent to Google/
# Microsoft during token exchange. Must exactly match what's registered
# in each provider's app console AND what the frontend actually
# redirected from (e.g. https://riseply.com in production).
OAUTH_FRONTEND_BASE_URL=http://localhost:3000

# --- Org Buddy as a Service: hybrid pricing (base plan + overage) ---
# Real prices/seat counts live in Stripe -- these are reference values
# used for overage math and the admin dashboard's display. Keep in sync
# manually if you change the actual Stripe Prices.
ORG_PLAN_STARTER_PRICE_USD=199.0
ORG_PLAN_STARTER_SEATS=10
ORG_PLAN_GROWTH_PRICE_USD=599.0
ORG_PLAN_GROWTH_SEATS=50
ORG_PLAN_OVERAGE_PRICE_PER_SEAT_USD=8.0
# Stripe Price IDs for each plan's base recurring subscription.
STRIPE_PRICE_ID_ORG_STARTER=
STRIPE_PRICE_ID_ORG_GROWTH=

# --- Auto-submit ---
# Global kill-switch, defaults off. Only ever fires on an application the
# user has already approved, and only against domains in the allowlist.
AUTO_SUBMIT_ENABLED=false
AUTO_SUBMIT_ALLOWED_DOMAINS=boards.greenhouse.io,job-boards.greenhouse.io,jobs.lever.co,jobs.ashbyhq.com,apply.workable.com

# --- Free tier limits (per user per calendar month) ---
FREE_TIER_MAX_MATCHES_PER_MONTH=50
FREE_TIER_MAX_TAILORED_RESUMES_PER_MONTH=15
FREE_TIER_MAX_INTERVIEW_PREPS_PER_MONTH=10
FREE_TIER_MAX_ONBOARDING_PLANS_PER_MONTH=5
FREE_TIER_MAX_JOB_BUDDY_MESSAGES_PER_MONTH=60
FREE_TIER_MAX_SEARCH_PROFILES=1

# --- Pro tier limits ---
PRO_TIER_MAX_MATCHES_PER_MONTH=300
PRO_TIER_MAX_TAILORED_RESUMES_PER_MONTH=100
PRO_TIER_MAX_INTERVIEW_PREPS_PER_MONTH=50
PRO_TIER_MAX_ONBOARDING_PLANS_PER_MONTH=30
PRO_TIER_MAX_JOB_BUDDY_MESSAGES_PER_MONTH=500
PRO_TIER_MAX_SEARCH_PROFILES=10

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000
